# Supported providers: github, gitlab, bitbucket
REPO_PROVIDER=github

# Repository host, used for homepage and remote URLs.
REPO_HOST=github.com

# Web base URL for the provider.
REPO_WEB_BASE_URL=https://github.com

# API base URL for the provider.
REPO_API_BASE_URL=https://api.github.com

# Default owner/organization.
REPO_OWNER=angelpixel-core

# Default repository name.
REPO_NAME=coffee-chatbot-ai-rag-langchain

# Default human-readable description.
REPO_DESCRIPTION="A coffee chatbot monorepo with Django, Next.js, and AWS/EKS provisioning."

# Default SPDX license identifier.
REPO_LICENSE=apache-2.0

# Default visibility flags. Keep PRIVATE=true unless you explicitly want a public repo.
REPO_PRIVATE=true
REPO_PUBLIC=false
